# Template for `.env`, which Docker Compose reads. Copy it to `.env` and
# set the value. Git ignores `.env`: do not commit a copy that holds a key.
#
# `engine.docker.toml` reads this variable when the engine loads it.
# A ws:// or wss:// URL receives new blocks by subscription. An http:// or
# https:// URL polls.

MAINNET_RPC_URL=wss://<your mainnet endpoint>

# The image to run. Without it, Compose uses
# ghcr.io/nullislabs/shepherd:latest.
# SHEPHERD_IMAGE=ghcr.io/nullislabs/shepherd:sha-<short>
