# Rust / Cargo
/target/
**/*.rs.bk


# Nix
/result
.direnv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*
# Exception: the committed template (operator copies it to `.env`,
# which is then caught by the rule above).
!.env.example

# Agent skills / AI tooling. The shared Claude Code config (settings.json
# plus the repo hooks) is tracked; personal and per-session state is not.
.agents/
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
.claude/worktrees/
skills-lock.json

# Engine runtime state (default state_dir from engine.toml).
data/
# Shipped crate data slices are source, not runtime state: keep them.
!crates/*/data/
!crates/*/data/**

# Local copies of an engine config, which can hold an RPC URL with a key.
*.local.toml
/engine.toml

# Evidence of a soak run: see docs/operations/soak-runbook.md.
/soak-evidence/
